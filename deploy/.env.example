# =============================================================================
# 环境变量模板
# -----------------------------------------------------------------------------
# 用法：复制为 .env，填入真实值。.env 已在 .gitignore 里，不会进仓库。
#
#   cp .env.example .env
#   chmod 600 .env        # 只有 root 可读，里面都是密钥
# =============================================================================

# MySQL root 密码（只在容器内部用，不对外）
MYSQL_ROOT_PASSWORD=改成至少16位随机串

# 应用数据库账号密码（与 docker-compose 里的 MYSQL_PASSWORD 一致）
DB_PASSWORD=改成至少16位随机串

# 又拍云操作员密码
UPYUN_PASSWORD=你的又拍云操作员密码

# JWT 签名密钥，至少 32 字节
# 生成方法：openssl rand -base64 48
JWT_SECRET=改成至少32字节的随机串
